resource "aws_vpc" "vpc2" {
  cidr_block = var.vpc2_cidr

  tags = {
    Name = var.vpc2_name
  }
}

resource "aws_subnet" "sub2" {
  vpc_id                  = aws_vpc.vpc2.id
  cidr_block              = var.sub2_cidr
  map_public_ip_on_launch = true

  tags = {
    Name = var.sub2_name
  }
}

resource "aws_internet_gateway" "igw2" {
  vpc_id = aws_vpc.vpc2.id

  tags = {
    Name = var.igw2_name
  }
}

resource "aws_route_table" "rt2" {
  vpc_id = aws_vpc.vpc2.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw2.id
  }

  tags = {
    Name = var.rt2_name
  }
}

resource "aws_route_table_association" "rta2" {
  subnet_id      = aws_subnet.sub2.id
  route_table_id = aws_route_table.rt2.id
}
resource "aws_instance" "vm1" {
  ami                         = var.ami_id
  instance_type               = var.instance_type
  key_name                    = var.am1_key_name
  subnet_id                   = aws_subnet.sub2.id
  vpc_security_group_ids      = [aws_security_group.vm_sg.id]
  associate_public_ip_address = true

  tags = {
    Name = "vm1"
  }
}

resource "aws_lb_target_group" "tg2" {
  name        = var.tg2_name
  port        = var.tg2_port
  protocol    = var.tg2_protocol
  vpc_id      = aws_vpc.vpc2.id
  target_type = "instance"

  health_check {
    protocol = "HTTP"
    path     = var.tg2_health_check_path
  }

  tags = {
    Name = var.tg2_name
  }
}

resource "aws_lb" "nlb2" {
  name               = var.nlb2_name
  load_balancer_type = "network"
  internal           = false
  ip_address_type    = var.nlb2_ip_address_type

  subnet_mapping {
    subnet_id = aws_subnet.sub2.id
  }

  tags = {
    Name = var.nlb2_name
  }
}

resource "aws_lb_listener" "listener" {
  load_balancer_arn = aws_lb.nlb2.arn
  port              = var.tg22_port
  protocol          = var.tg22_protocol

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.tg2.arn
  }
}

resource "aws_lb_target_group_attachment" "attach" {
  target_group_arn = aws_lb_target_group.tg2.arn
  target_id        = aws_instance.vm1.id
  port             = var.tg2_port
}